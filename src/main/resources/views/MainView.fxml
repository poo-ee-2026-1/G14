            </Label>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Label fx:id="lblPotenciaTotal" text="Potência Utilizada: 0 kW / 350 kW" textFill="#a0aab5">
               <font>
                  <Font name="Consolas" size="14.0" />
                </font>
            </Label>
         </children>
      </HBox>
   </top>
   
   <center>
      <GridPane fx:id="gridPontos" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
